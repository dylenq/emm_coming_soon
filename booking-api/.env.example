PORT=3000
SITE_ORIGIN=https://emm.yeetserver.org
API_BASE_URL=https://emm-api.yeetserver.org
TZ=Asia/Colombo
DEV_FAKE_CALENDAR=
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google-sa.json
# e.g. smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=
# e.g. EMM <bookings@your-domain>
MAIL_FROM=
# Inbox that receives contact-form messages
CONTACT_TO=
# Number of reverse proxies in front of the API (for per-IP rate limiting)
TRUST_PROXY=
DB_PATH=/data/bookings.db
